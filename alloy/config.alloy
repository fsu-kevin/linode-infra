// Node exporter - VM metrics
prometheus.exporter.unix "node" {}

prometheus.scrape "node_metrics" {
  targets         = prometheus.exporter.unix.node.targets
  forward_to      = [prometheus.remote_write.metrics_service.receiver]
  scrape_interval = "15s"
}

// Alloy self health metrics
prometheus.exporter.self "alloy_health" {}

discovery.relabel "alloy_health" {
  targets = prometheus.exporter.self.alloy_health.targets

  rule {
    replacement  = constants.hostname
    target_label = "instance"
  }

  rule {
    target_label = "job"
    replacement  = "integrations/alloy"
  }
}

prometheus.scrape "alloy_health" {
  targets    = discovery.relabel.alloy_health.output
  forward_to = [prometheus.remote_write.metrics_service.receiver]
  job_name   = "integrations/alloy"
}

prometheus.remote_write "metrics_service" {
  endpoint {
    url = "https://prometheus-prod-66-prod-us-east-3.grafana.net/api/prom/push"
    basic_auth {
      username = env("GRAFANA_METRICS_USER")
      password = env("GRAFANA_API_KEY")
    }
  }
}

// access_application: visitors, app events, vault access, object storage activity
loki.source.file "access_nginx" {
  targets = [{
    __path__ = "/var/log/nginx/access.log",
    instance = constants.hostname,
    job      = "access_application",
    type     = "visitor",
  }]
  forward_to = [loki.write.grafanacloud.receiver]
}

loki.source.file "access_app" {
  targets = [{
    __path__ = "/root/.pm2/logs/*.log",
    instance = constants.hostname,
    job      = "access_application",
    type     = "app_event",
  }]
  forward_to = [loki.write.grafanacloud.receiver]
}

loki.source.file "access_vault" {
  targets = [{
    __path__ = "/var/log/vault-agent.log",
    instance = constants.hostname,
    job      = "access_application",
    type     = "vault_access",
  }]
  forward_to = [loki.write.grafanacloud.receiver]
}

loki.source.file "access_storage" {
  targets = [{
    __path__ = "/var/log/object-storage.log",
    instance = constants.hostname,
    job      = "access_application",
    type     = "storage_event",
  }]
  forward_to = [loki.write.grafanacloud.receiver]
}

loki.write "grafanacloud" {
  endpoint {
    url = "https://logs-prod-042.grafana.net/loki/api/v1/push"
    basic_auth {
      username = env("GRAFANA_LOKI_USER")
      password = env("GRAFANA_API_KEY")
    }
  }
}
